#!/usr/bin/env bash
# git-lopper — find stale git worktrees in many repositories and remove them safely.
# https://github.com/albertovincenzi/git-lopper — MIT License
#
# Needs bash 3.2+ (the macOS default) and git 2.17+ (git worktree remove).
# Optional: gh (pull request state), lsof or /proc (in-use check),
# sqlite3 (Bloom integration), less (paging).

LOPPER_VERSION=0.1.0
CLASSES="PRUNE SAFE LIKELY KEEP REVIEW"
CLEANABLE="PRUNE SAFE LIKELY"
TAB=$'\t'
HEADER="class${TAB}reason${TAB}repo${TAB}path${TAB}branch${TAB}base${TAB}pr${TAB}pr_head${TAB}upstream${TAB}last_commit"

DEPTH=${LOPPER_DEPTH:-3}
CACHE_DIR=${LOPPER_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/git-lopper}
BLOOM_DB=${LOPPER_BLOOM_DB:-$HOME/Library/Application Support/Bloom/bloom.sqlite}
BLOOM_DIR=${LOPPER_BLOOM_DIR:-$HOME/bloom/workspaces.noindex}
BLOOM_DIR=${BLOOM_DIR%/}
LOG=$CACHE_DIR/last-clean.log

die() { printf 'git-lopper: %s\n' "$*" >&2; exit 2; }

usage() {
  cat <<EOF
git-lopper $LOPPER_VERSION — find stale git worktrees and remove them safely

Usage:
  git lopper [options]                    open the interactive app
  git lopper [options] scan [--no-fetch]  scan, save the result, print a summary
  git lopper [options] list [CLASS...]    print the saved scan (--tsv for raw rows)
  git lopper [options] clean CLASS...     remove PRUNE, SAFE or LIKELY worktrees
                                          (--dry-run to preview, --yes to skip the prompt)
Options:
  -C, --root DIR   folder that holds your repositories (default: current folder)
  -d, --depth N    how deep to look for repositories (default: 3)
  -h, --help       show this help (use -h with 'git lopper': git maps --help to man)
  -V, --version    show the version

Classes:
  PRUNE   folder already gone, only git metadata left
  SAFE    clean, HEAD already in the default branch
  LIKELY  clean, PR merged or closed, or remote branch deleted
  KEEP    changes, unpushed commits, a rebase in progress, or locked  (never cleaned)
  REVIEW  open PR, no PR, never pushed, or commits only here          (never cleaned)

Safety: never uses --force and never deletes branches. Skips worktrees that a
running process uses, active Bloom workspaces, and worktrees that hold another
repository. Checks every worktree again right before it removes it.

Environment: LOPPER_DEPTH, LOPPER_CACHE_DIR, LOPPER_BLOOM_DB, LOPPER_BLOOM_DIR, NO_COLOR
EOF
}

# ── look ───────────────────────────────────────────────────────────────
setup_look() { # colours only on a terminal without NO_COLOR; ASCII glyphs outside UTF-8
  RST='' BLD='' DIM='' INV='' ACC='' GRN='' CYN='' YEL='' RED='' GRY=''
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    RST=$'\033[0m' BLD=$'\033[1m' DIM=$'\033[2m' INV=$'\033[7m'
    ACC=$'\033[38;5;141m' GRN=$'\033[38;5;42m' CYN=$'\033[38;5;45m'
    YEL=$'\033[38;5;214m' RED=$'\033[38;5;203m' GRY=$'\033[38;5;245m'
  fi
  case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
    *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) G_DOT=● G_OK=✔ G_SKIP=⏸ G_FAIL=✖ G_FULL=█ G_EMPTY=░ G_RULE=─ G_LOGO=✂ ;;
    *) G_DOT='*' G_OK=+ G_SKIP=- G_FAIL=x G_FULL='#' G_EMPTY=. G_RULE=- G_LOGO='>8' ;;
  esac
}

class_color() {
  case $1 in PRUNE) printf %s "$GRY" ;; SAFE) printf %s "$GRN" ;; LIKELY) printf %s "$CYN" ;; KEEP) printf %s "$RED" ;; REVIEW) printf %s "$YEL" ;; esac
}
class_desc() {
  case $1 in
    PRUNE) echo "folder already gone, only git metadata left" ;;
    SAFE) echo "clean, HEAD already in the default branch" ;;
    LIKELY) echo "clean, PR merged/closed or remote branch deleted" ;;
    KEEP) echo "changes, unpushed commits or locked" ;;
    REVIEW) echo "open PR, no PR or never pushed" ;;
  esac
}
repeat() { local s='' i; for ((i = 0; i < $2; i++)); do s+=$1; done; printf %s "$s"; }
bar() { # VALUE MAX WIDTH COLOUR
  local f=0
  [ "$2" -gt 0 ] && f=$(($1 * $3 / $2))
  [ "$1" -gt 0 ] && [ "$f" -eq 0 ] && f=1
  printf '%s%s%s%s%s' "$4" "$(repeat "$G_FULL" "$f")" "$GRY$DIM" "$(repeat "$G_EMPTY" $(($3 - f)))" "$RST"
}
progress() { # I N LABEL — on stderr, only when stderr is a terminal
  [ -t 2 ] || return 0
  local label=$3 max=$((COLS - 44))
  [ "$max" -lt 10 ] && max=10
  printf '\r\033[K  %s %s%3d/%-3d%s %s' "$(bar "$1" "$2" 28 "$ACC")" "$BLD" "$1" "$2" "$RST" "${label:0:$max}" >&2
}
progress_done() { if [ -t 2 ]; then printf '\r\033[K' >&2; fi; }
tilde() { case $1 in "$HOME" | "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf %s "$1" ;; esac; }
keycap() { printf '%s %s %s %s' "$INV$ACC$BLD" "$1" "$RST" "$2"; }
badge() { if [ "$1" = 1 ]; then printf '%s%s %s%s' "$GRN" "$G_OK" "$2" "$RST"; else printf '%s%s %s%s' "$GRY" "$G_FAIL" "$2" "$RST"; fi; }

# Bloom and HFS+ store paths in NFD ("a" + accent), git prints NFC ("à"): compare in NFC.
if printf a | iconv -f UTF-8-MAC -t UTF-8 >/dev/null 2>&1; then
  nfc() { iconv -c -f UTF-8-MAC -t UTF-8 2>/dev/null; }
else
  nfc() { cat; }
fi

# ── rules ──────────────────────────────────────────────────────────────
classify() { # LOCKED BUSY DIRTY MERGED UPSTREAM PR ON_REMOTE -> CLASS<TAB>REASON
  local locked=$1 busy=$2 dirty=$3 merged=$4 up=$5 pr=$6 on_remote=$7
  if [ "$locked" = 1 ]; then printf 'KEEP\tlocked\n'
  elif [ "$busy" = 1 ]; then printf 'KEEP\trebase or merge in progress\n'
  elif [ "$dirty" -gt 0 ]; then printf 'KEEP\t%s changed file%s\n' "$dirty" "$([ "$dirty" = 1 ] || echo s)"
  elif [[ $up == *ahead* ]]; then printf 'KEEP\tunpushed commits\n'
  elif [ "$merged" = yes ]; then printf 'SAFE\talready in the default branch\n'
  elif [ "$pr" = MERGED ] || [ "$pr" = CLOSED ] || [ "$up" = "[gone]" ]; then
    # done upstream, but only LIKELY when no commit exists only here
    if [ "$on_remote" != yes ]; then printf 'REVIEW\tcommits not on any remote\n'
    elif [ "$pr" = MERGED ]; then printf 'LIKELY\tPR merged\n'
    elif [ "$pr" = CLOSED ]; then printf 'LIKELY\tPR closed\n'
    else printf 'LIKELY\tremote branch deleted\n'; fi
  elif [ "$pr" = OPEN ]; then printf 'REVIEW\tPR open\n'
  elif [ "$up" = none ]; then printf 'REVIEW\tnever pushed\n'
  elif [ "$up" = - ]; then printf 'REVIEW\tdetached HEAD\n'
  elif [ "$pr" = unknown ]; then printf 'REVIEW\tPR state unknown\n'
  else printf 'REVIEW\tno PR\n'; fi
}

on_remote() { # DIR COMMIT PR_HEAD — is COMMIT on a remote ref, or in the PR that was merged?
  [ -n "$(git -C "$1" for-each-ref --contains "$2" --count=1 --format=x refs/remotes 2>/dev/null)" ] && return 0
  [ "$3" = - ] && return 1
  [ "$2" = "$3" ] || git -C "$1" merge-base --is-ancestor "$2" "$3" 2>/dev/null
}

inspect() { # REPO PATH BRANCH BASE PR PR_HEAD LOCKED HEAD -> CLASS<TAB>REASON<TAB>UPSTREAM
  local repo=$1 wt=$2 br=$3 base=$4 pr=$5 pr_head=$6 locked=$7 head=$8 st dirty gd f busy=0 merged=no up=- remote=no
  [ "$locked" = 1 ] && { printf 'KEEP\tlocked\t-\n'; return; }
  if [ ! -d "$wt" ]; then
    # a missing detached worktree may hold the only reference to its commits
    if [ "$br" = "(detached)" ] && [ "$head" != - ] && [ -z "$(git -C "$repo" for-each-ref --contains "$head" --count=1 --format=x 2>/dev/null)" ]; then
      printf 'KEEP\tdetached commits only here\t-\n'
    else
      printf 'PRUNE\tfolder missing\t-\n'
    fi
    return
  fi
  st=$(git -C "$wt" status --porcelain --untracked-files=normal 2>/dev/null) || { printf 'KEEP\tgit status failed\t-\n'; return; }
  dirty=$(printf '%s' "$st" | grep -c .)
  gd=$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null)
  for f in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do [ -e "$gd/$f" ] && busy=1; done
  [ "$base" != - ] && git -C "$wt" merge-base --is-ancestor HEAD "$base" 2>/dev/null && merged=yes
  if [ "$br" != "(detached)" ]; then
    up=$(git -C "$wt" for-each-ref --format='%(if)%(upstream)%(then)%(upstream:track)%(else)none%(end)' "refs/heads/$br")
    [ -n "$up" ] || up=ok
  fi
  if [ "$pr" = MERGED ] || [ "$pr" = CLOSED ] || [ "$up" = "[gone]" ]; then
    on_remote "$wt" "$(git -C "$wt" rev-parse HEAD)" "$pr_head" && remote=yes
  fi
  printf '%s\t%s\n' "$(classify 0 "$busy" "$dirty" "$merged" "$up" "$pr" "$remote")" "$up"
}

# shortcut: reads Bloom's private sqlite schema; if the query fails, all of BLOOM_DIR counts as active.
load_guards() { # who must not lose a worktree right now
  BLOOM_ACTIVE=''
  BLOOM_DIR_REAL=$(cd "$BLOOM_DIR" 2>/dev/null && pwd -P) || BLOOM_DIR_REAL=$BLOOM_DIR
  if [ -f "$BLOOM_DB" ]; then
    # any state but 'archived' counts as active, so a new Bloom state fails safe
    BLOOM_ACTIVE=$(set -o pipefail; sqlite3 -readonly "$BLOOM_DB" "select path from workspaces where state <> 'archived'" 2>/dev/null | with_real_paths | nfc) || BLOOM_ACTIVE='*'
  fi
  CWDS=$(list_cwds | sort -u | nfc)
}
overlaps() { # MODE LIST PATH — "in": a line of LIST is PATH or inside it; "both": also PATH inside a line
  P=$3 M=$1 awk 'function under(a, b) { return a == b || index(a, b "/") == 1 }
    BEGIN { p = ENVIRON["P"]; m = ENVIRON["M"] }
    $0 != "" && (under($0, p) || (m == "both" && under(p, $0))) { f = 1; exit }
    END { exit !f }' <<<"$2"
}
holds_repo() { # PATH — a repository or worktree inside it would go with it (deps folders are not searched)
  [ -n "$(find "$1" -mindepth 2 -maxdepth 6 \( -name node_modules -o -name vendor -o -name .venv \) -prune -o -name .git -print 2>/dev/null | head -n 1)" ]
}
real_path() { # PATH without symlinks (/var -> /private/var); for a missing PATH, its parent is resolved
  local d
  if [ -d "$1" ]; then
    (cd "$1" 2>/dev/null && pwd -P)
  else
    d=$(cd "$(dirname "$1")" 2>/dev/null && pwd -P) && printf '%s/%s\n' "$d" "$(basename "$1")"
  fi
}
with_real_paths() { # each path, plus its real path
  while IFS= read -r p; do printf '%s\n' "$p"; real_path "$p"; done
  true
}
list_cwds() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -d cwd -Fn 2>/dev/null | sed -n 's/^n//p'
  elif [ -e /proc/self/cwd ]; then
    for p in /proc/[0-9]*/cwd; do readlink "$p" 2>/dev/null; done
  fi
}

protected() { # PATH -> why it must stay, or nothing
  local raw real p
  raw=$(printf '%s' "$1" | nfc)
  real=$(real_path "$1" | nfc)
  [ -n "$real" ] || real=$raw
  for p in "$raw" "$real"; do
    if [ "$BLOOM_ACTIVE" = '*' ]; then
      overlaps both "$BLOOM_DIR"$'\n'"$BLOOM_DIR_REAL" "$p" && { echo "Bloom workspace (Bloom db unreadable)"; return; }
    elif [ -n "$BLOOM_ACTIVE" ]; then
      overlaps both "$BLOOM_ACTIVE" "$p" && { echo "active Bloom workspace"; return; }
    fi
    overlaps in "$CWDS" "$p" && { echo "in use by a running process"; return; }
  done
}

decide() { # WANTED CLASS REPO PATH BRANCH BASE PR PR_HEAD -> ACTION<TAB>REASON (prune | remove | skip)
  local why fresh class
  why=$(protected "$4")
  [ -z "$why" ] || { printf 'skip\t%s\n' "$why"; return; }
  if [ "$2" = PRUNE ]; then
    if [ -e "$4" ]; then printf 'skip\tfolder exists again\n'; else printf 'prune\tfolder missing\n'; fi
    return
  fi
  fresh=$(inspect "$3" "$4" "$5" "$6" "$7" "$8" 0 -) # git itself refuses a locked worktree
  class=${fresh%%"$TAB"*}
  case " $1 " in
    *" $class "*) ;;
    *) printf 'skip\tchanged since the scan (now %s: %s)\n' "$class" "$(printf '%s' "$fresh" | cut -f2)"; return ;;
  esac
  if holds_repo "$4"; then printf 'skip\tholds another repository or worktree\n'; return; fi
  printf 'remove\t%s\n' "$(printf '%s' "$fresh" | cut -f2)"
}

# ── scan ───────────────────────────────────────────────────────────────
set_root() {
  ROOT=$(cd "$1" 2>/dev/null && pwd -P) || die "not a folder: $1"
  DATA=$CACHE_DIR/$(printf %s "$ROOT" | git hash-object --stdin).tsv
}
have_data() { [ -f "$DATA" ] || die "no scan for $(tilde "$ROOT") yet: run 'git lopper scan' first"; }

find_repos() { # repos under ROOT (and the one around it) that have linked worktrees
  {
    find "$ROOT" -maxdepth "$DEPTH" -name .git -type d -prune 2>/dev/null | sed 's|/\.git$||'
    git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null | sed 's|/\.git$||'
  } | sort -u | while IFS= read -r repo; do
    if [ "$(git -C "$repo" worktree list 2>/dev/null | wc -l)" -gt 1 ]; then printf '%s\n' "$repo"; fi
  done
}

scan_repo() { # FETCH REPO I N — prints the rows of one repo
  local repo=$2 name main remote base b prs='' no_pr=$NO_PR wt ref locked head br pr pr_head state class reason up last
  name=${repo##*/}
  main=$(git -C "$repo" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')
  remote=origin
  git -C "$repo" remote | grep -qx origin || remote=$(git -C "$repo" remote | head -n 1)
  if [ "$1" = 1 ] && [ -n "$remote" ]; then
    progress "$3" "$4" "$name · fetch"
    GIT_TERMINAL_PROMPT=0 git -C "$repo" fetch --prune --quiet "$remote" >/dev/null 2>&1
  fi
  base=$(git -C "$repo" symbolic-ref --short "refs/remotes/$remote/HEAD" 2>/dev/null)
  if [ -z "$base" ]; then
    for b in main master develop trunk; do
      if git -C "$repo" rev-parse -q --verify "refs/remotes/$remote/$b" >/dev/null; then base=$remote/$b; break; fi
    done
  fi
  [ -n "$base" ] || base=-
  if [ "$NO_PR" = none ]; then
    progress "$3" "$4" "$name · pull requests"
    # PRs from forks are skipped: their branch names say nothing about ours
    prs=$(cd "$repo" && gh pr list --state all --limit 2000 --json headRefName,state,headRefOid,isCrossRepository \
      -q '.[] | select(.isCrossRepository | not) | "\(.headRefName)\t\(.state)\t\(.headRefOid)"' 2>/dev/null) || no_pr=unknown
  fi
  git -C "$repo" worktree list --porcelain | awk '
    /^worktree / {p = substr($0, 10)} /^HEAD / {h = substr($0, 6)} /^branch / {b = substr($0, 8)}
    /^detached/ {b = "(detached)"} /^locked/ {l = 1}
    /^$/ {if (p != "") print p "\t" b "\t" (l + 0) "\t" h; p = ""; b = ""; l = 0; h = "-"}
    END {if (p != "") print p "\t" b "\t" (l + 0) "\t" h}' |
    while IFS=$TAB read -r wt ref locked head; do
      [ "$wt" = "$main" ] && continue
      br=${ref#refs/heads/}
      progress "$3" "$4" "$name · $br"
      # gh lists the newest PR first, so the first match is the current one
      IFS=$TAB read -r pr pr_head <<<"$(printf '%s\n' "$prs" | awk -F'\t' -v b="$br" '$1 == b {print $2 "\t" $3; exit}')"
      pr=${pr:-$no_pr} pr_head=${pr_head:--}
      state=$(inspect "$repo" "$wt" "$br" "$base" "$pr" "$pr_head" "$locked" "${head:--}")
      IFS=$TAB read -r class reason up <<<"$state"
      last=$(git -C "$wt" log -1 --format=%cd --date=short 2>/dev/null) || last=-
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$class" "$reason" "$repo" "$wt" "$br" "$base" "$pr" "$pr_head" "$up" "${last:--}"
    done
}

scan() { # FETCH (1 = git fetch --prune first) — writes DATA
  local repos n i=0 repo
  mkdir -p "$CACHE_DIR" || die "cannot create $CACHE_DIR"
  NO_PR=unknown WARN=''
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then NO_PR=none; else WARN="gh is missing or not logged in: PR state is unknown, so fewer worktrees are LIKELY"; fi
  repos=$(find_repos)
  n=$(printf '%s' "$repos" | grep -c .)
  {
    printf '%s\n' "$HEADER"
    printf '%s\n' "$repos" | while IFS= read -r repo; do
      [ -n "$repo" ] || continue
      i=$((i + 1))
      scan_repo "$1" "$repo" "$i" "$n" </dev/null
    done
  } >"$DATA.$$" && mv "$DATA.$$" "$DATA"
  progress_done
}

# ── clean ──────────────────────────────────────────────────────────────
make_plan() { # "CLASS ..." — writes $WORK/plan, rows: action reason class repo path branch base pr pr_head
  local n i=0 class reason repo wt br base pr pr_head up last
  load_guards
  n=$(awk -F'\t' -v w=" $1 " 'NR > 1 && index(w, " " $1 " ") {n++} END {print n + 0}' "$DATA")
  awk -F'\t' -v w=" $1 " 'NR > 1 && index(w, " " $1 " ")' "$DATA" |
    while IFS=$TAB read -r class reason repo wt br base pr pr_head up last; do
      i=$((i + 1))
      progress "$i" "$n" "checking ${repo##*/} · $br"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(decide "$1" "$class" "$repo" "$wt" "$br" "$base" "$pr" "$pr_head")" \
        "$class" "$repo" "$wt" "$br" "$base" "$pr" "$pr_head"
    done >"$WORK/plan"
  progress_done
}

run_plan() { # "CLASS ..." — runs $WORK/plan, sets DONE SKIPPED REFUSED
  local n i=0 action reason class repo wt br base pr pr_head now
  DONE=0 SKIPPED=0 REFUSED=0
  n=$(grep -cE "^(remove|prune)$TAB" "$WORK/plan")
  : >"$LOG"
  : >"$WORK/gone"
  load_guards # again: things may have changed while the plan was on screen
  while IFS=$TAB read -r action reason class repo wt br base pr pr_head; do
    case $action in remove | prune) ;; *) continue ;; esac
    i=$((i + 1))
    progress "$i" "$n" "${repo##*/} · ${wt##*/}"
    now=$(decide "$1" "$class" "$repo" "$wt" "$br" "$base" "$pr" "$pr_head")
    case ${now%%"$TAB"*} in
      remove | prune) ;;
      *) SKIPPED=$((SKIPPED + 1)); printf 'SKIPPED %s: %s\n' "$wt" "${now#*"$TAB"}" >>"$LOG"; continue ;;
    esac
    # also for a missing folder: unlike `worktree prune`, it drops only this entry
    if git -C "$repo" worktree remove "$wt" >>"$LOG" 2>&1 </dev/null; then
      DONE=$((DONE + 1)); printf '%s\n' "$wt" >>"$WORK/gone"
    else
      REFUSED=$((REFUSED + 1)); printf 'REFUSED %s\n' "$wt" >>"$LOG"
    fi
  done <"$WORK/plan"
  progress_done
  # drop the removed rows, so the saved scan stays right without a new scan
  awk -F'\t' 'FILENAME == ARGV[1] {gone[$0] = 1; next} !($4 in gone)' "$WORK/gone" "$DATA" >"$DATA.$$" && mv "$DATA.$$" "$DATA"
}

# ── output ─────────────────────────────────────────────────────────────
summary_rows() {
  local cls n max=1 counts
  counts=$(awk -F'\t' 'NR > 1 {n[$1]++} END {for (c in n) print c, n[c]}' "$DATA")
  for cls in $CLASSES; do
    n=$(printf '%s\n' "$counts" | awk -v c="$cls" '$1 == c {print $2}')
    eval "N_$cls=${n:-0}"
    [ "${n:-0}" -gt "$max" ] && max=$n
  done
  for cls in $CLASSES; do
    eval "n=\$N_$cls"
    printf '  %s%s%s %s%-7s%s %5d  %s' "$(class_color "$cls")" "$G_DOT" "$RST" "$BLD" "$cls" "$RST" "$n" "$(bar "$n" "$max" 22 "$(class_color "$cls")")"
    [ "$COLS" -ge 96 ] && printf '  %s%s%s' "$GRY" "$(class_desc "$cls")" "$RST"
    printf '\n'
  done
}

render_list() { # "CLASS ..." — the saved scan, grouped by repo
  awk -F'\t' -v w=" $1 " -v home="$HOME" -v b="$BLD" -v d="$GRY" -v r="$RST" -v dot="$G_DOT" \
    -v cP="$GRY" -v cS="$GRN" -v cL="$CYN" -v cK="$RED" -v cR="$YEL" '
    function tilde(p) { return index(p, home "/") == 1 ? "~" substr(p, length(home) + 1) : p }
    BEGIN { col["PRUNE"] = cP; col["SAFE"] = cS; col["LIKELY"] = cL; col["KEEP"] = cK; col["REVIEW"] = cR }
    NR == 1 || !index(w, " " $1 " ") { next }
    $3 != repo { repo = $3; n = split(repo, part, "/"); printf "\n %s%s%s  %s%s%s\n", b, part[n], r, d, tilde(repo), r }
    { printf "   %s%s %-6s%s %-40.40s %s%-30.30s%s %s%s%s\n     %s%s%s\n", col[$1], dot, $1, r, $5, col[$1], $2, r, d, $9, r, d, tilde($4), r }' "$DATA"
}

render_plan() { # PLANFILE
  awk -F'\t' -v g="$GRN" -v y="$YEL" -v d="$GRY" -v r="$RST" -v home="$HOME" '
    { c = ($1 == "skip") ? y : g; p = $5; if (index(p, home "/") == 1) p = "~" substr(p, length(home) + 1)
      printf "  %s%-7s%s %-46.46s %s%s%s\n", c, $1, r, $2, d, p, r }' "$1"
}

plan_summary() { # PLANFILE
  printf '    %s%s%s  %-34s %4d\n' "$GRN" "$G_OK" "$RST" "remove" "$(grep -cE "^(remove|prune)$TAB" "$1")"
  awk -F'\t' '$1 == "skip" {r = $2; sub(/ \(.*$/, "", r); print r}' "$1" | sort | uniq -c | sort -rn |
    while read -r count why; do printf '    %s%s%s  %-34s %4d\n' "$YEL" "$G_SKIP" "$RST" "skip: $why" "$count"; done
  [ "$HAS_CWD" = 1 ] || printf '\n    %s%s no lsof and no /proc: running sessions cannot be detected%s\n' "$RED" "$G_FAIL" "$RST"
}

print_result() {
  printf '\n  %s%s removed %d%s' "$GRN$BLD" "$G_OK" "$DONE" "$RST"
  [ "$SKIPPED" -gt 0 ] && printf '   %s%s skipped %d (changed since the plan)%s' "$YEL$BLD" "$G_SKIP" "$SKIPPED" "$RST"
  [ "$REFUSED" -gt 0 ] && printf '   %s%s refused by git %d%s' "$RED$BLD" "$G_FAIL" "$REFUSED" "$RST"
  printf '\n'
  if [ "$REFUSED" -gt 0 ]; then grep -E '^(fatal|error|REFUSED)' "$LOG" | head -12 | sed 's/^/    /'; fi
  printf '  %slog: %s%s\n' "$GRY" "$(tilde "$LOG")" "$RST"
}

# ── commands ───────────────────────────────────────────────────────────
cmd_scan() {
  scan "$1"
  summary_rows
  [ -z "$WARN" ] || printf '\n%s%s%s\n' "$YEL" "$WARN" "$RST" >&2
}

cmd_list() { # TSV CLASS...
  local tsv=$1 want
  shift
  have_data
  want=${*:-$CLASSES}
  if [ "$tsv" = 1 ]; then awk -F'\t' -v w=" $want " 'NR == 1 || index(w, " " $1 " ")' "$DATA"; else render_list "$want"; fi
}

cmd_clean() { # DRY YES CLASS...
  local dry=$1 yes=$2 c todo answer
  shift 2
  [ $# -gt 0 ] || die "clean needs one or more of: $CLEANABLE"
  for c in "$@"; do case " $CLEANABLE " in *" $c "*) ;; *) die "$c is never cleaned (only $CLEANABLE)" ;; esac; done
  have_data
  make_plan "$*"
  todo=$(grep -cE "^(remove|prune)$TAB" "$WORK/plan")
  printf '%sclean %s%s  %s\n' "$BLD" "$*" "$RST" "$(tilde "$ROOT")"
  plan_summary "$WORK/plan"
  if [ "$dry" = 1 ]; then printf '\n'; render_plan "$WORK/plan"; return 0; fi
  [ "$todo" -gt 0 ] || return 0
  if [ "$yes" != 1 ]; then
    [ -t 0 ] || die "no terminal to confirm: add --yes, or --dry-run to preview"
    printf '\nRemove %d worktrees? [y/N] ' "$todo"
    read -r answer
    case $answer in y | Y | yes) ;; *) echo "nothing removed."; return 0 ;; esac
  fi
  run_plan "$*"
  print_result
  [ "$REFUSED" -eq 0 ]
}

# ── interactive app ────────────────────────────────────────────────────
pause() { printf '\n  %spress any key%s ' "$GRY" "$RST"; read -rsn1; }
pager() { if command -v less >/dev/null 2>&1; then less -RS; else cat; pause; fi; }

header() {
  local info="no scan yet" gh=0
  command -v gh >/dev/null 2>&1 && gh=1
  [ -f "$DATA" ] && info="$(($(wc -l <"$DATA") - 1)) worktrees in $(awk -F'\t' 'NR > 1 {print $3}' "$DATA" | sort -u | wc -l | tr -d ' ') repos · scanned $(LC_ALL=C date -r "$DATA" '+%a %d %b %H:%M')"
  clear
  printf '\n  %s%s  GIT LOPPER%s  %s%s%s   %s %s' "$BLD$ACC" "$G_LOGO" "$RST" "$GRY" "$(tilde "$ROOT")" "$RST" "$(badge "$gh" gh)" "$(badge "$HAS_CWD" in-use)"
  [ "$HAS_BLOOM" = 1 ] && printf ' %s' "$(badge 1 Bloom)"
  printf '\n  %s%s%s\n  %s%s%s\n\n' "$ACC$DIM" "$(repeat "$G_RULE" 66)" "$RST" "$GRY" "$info" "$RST"
}

pick_class() { # "CLASS ..." -> sets PICKED, returns 1 on back
  local i=1 cls
  for cls in $1; do
    printf '    %s%d%s  %s%s%s %s%-7s%s %s%s%s\n' "$BLD" "$i" "$RST" "$(class_color "$cls")" "$G_DOT" "$RST" "$BLD" "$cls" "$RST" "$GRY" "$(class_desc "$cls")" "$RST"
    i=$((i + 1))
  done
  printf '\n  %spick a number · any other key: back%s ' "$GRY" "$RST"
  read -rsn1
  i=1
  for cls in $1; do
    if [ "$REPLY" = "$i" ]; then PICKED=$cls; return 0; fi
    i=$((i + 1))
  done
  return 1
}

dashboard() {
  header
  if [ -f "$DATA" ]; then summary_rows; else printf '  %sNo scan yet.%s Press %s to start.\n' "$YEL" "$RST" "$(keycap s scan)"; fi
  printf '\n  %s   %s   %s   %s   %s   %s\n\n  ' "$(keycap s scan)" "$(keycap f 'fast scan')" "$(keycap l list)" "$(keycap c clean)" "$(keycap '?' help)" "$(keycap q quit)"
}

scan_screen() { # FETCH
  header
  printf '  %sSCAN%s  %s%s%s\n\n' "$BLD" "$RST" "$GRY" "$([ "$1" = 1 ] && echo 'git fetch --prune, then PR state from gh' || echo 'no fetch, PR state from gh')" "$RST"
  tput civis 2>/dev/null
  scan "$1"
  tput cnorm 2>/dev/null
  if [ -n "$WARN" ]; then printf '  %s%s%s\n' "$YEL" "$WARN" "$RST"; pause; fi
}

list_screen() {
  header
  printf '  %sLIST%s  which class?\n\n' "$BLD" "$RST"
  pick_class "$CLASSES" || return
  render_list "$PICKED" | pager
}

clean_screen() {
  local todo
  header
  printf '  %sCLEAN%s  which class?  %s(KEEP and REVIEW are never cleaned)%s\n\n' "$BLD" "$RST" "$GRY" "$RST"
  pick_class "$CLEANABLE" || return
  printf '\n\n'
  tput civis 2>/dev/null
  make_plan "$PICKED"
  tput cnorm 2>/dev/null
  todo=$(grep -cE "^(remove|prune)$TAB" "$WORK/plan")
  while :; do
    header
    printf '  %sCLEAN%s  %s%s%s\n\n' "$BLD" "$RST" "$(class_color "$PICKED")$BLD" "$PICKED" "$RST"
    plan_summary "$WORK/plan"
    if [ "$todo" -eq 0 ]; then printf '\n  nothing to remove.\n'; pause; break; fi
    printf '\n  %s   %s   %s\n\n  ' "$(keycap y "remove $todo")" "$(keycap v 'view plan')" "$(keycap b back)"
    read -rsn1
    case $REPLY in
      y)
        printf '\n'; tput civis 2>/dev/null
        run_plan "$PICKED"
        tput cnorm 2>/dev/null
        print_result; pause; break ;;
      v) render_plan "$WORK/plan" | pager ;;
      *) break ;;
    esac
  done
}

tui() {
  if [ ! -t 0 ] || [ ! -t 1 ]; then die "the interactive app needs a terminal (see -h for commands)"; fi
  IN_TUI=1
  tput smcup 2>/dev/null
  trap 'exit 130' INT
  while :; do
    dashboard
    read -rsn1 || exit 0 # stdin closed: stop, do not repaint forever
    case $REPLY in
      s) scan_screen 1 ;;
      f) scan_screen 0 ;;
      l) [ -f "$DATA" ] && list_screen ;;
      c) [ -f "$DATA" ] && clean_screen ;;
      '?') clear; usage; pause ;;
      q) exit 0 ;;
    esac
  done
}

on_exit() {
  if [ -n "${IN_TUI:-}" ]; then tput cnorm 2>/dev/null; tput rmcup 2>/dev/null; fi
  [ -z "${DATA:-}" ] || rm -f "$DATA.$$"
  [ -z "${WORK:-}" ] || { rm -f "$WORK/plan" "$WORK/gone"; rmdir "$WORK" 2>/dev/null; }
}

main() {
  local root=. cmd='' fetch=1 tsv=0 dry=0 yes=0 c
  local -a args=()
  while [ $# -gt 0 ]; do
    case $1 in
      -C | --root) [ $# -ge 2 ] || die "$1 needs a folder"; root=$2; shift ;;
      -d | --depth) case ${2:-} in '' | *[!0-9]*) die "$1 needs a number" ;; esac; DEPTH=$2; shift ;;
      --no-fetch) fetch=0 ;;
      --tsv) tsv=1 ;;
      -n | --dry-run) dry=1 ;;
      -y | --yes) yes=1 ;;
      -h | --help) usage; exit 0 ;;
      -V | --version) printf 'git-lopper %s\n' "$LOPPER_VERSION"; exit 0 ;;
      -*) die "unknown option: $1 (try -h)" ;;
      *) if [ -z "$cmd" ]; then cmd=$1; else args+=("$(printf %s "$1" | tr '[:lower:]' '[:upper:]')"); fi ;;
    esac
    shift
  done
  command -v git >/dev/null 2>&1 || die "git is not installed"
  case $cmd in list | clean)
    for c in ${args[@]+"${args[@]}"}; do case " $CLASSES " in *" $c "*) ;; *) die "unknown class: $c (one of: $CLASSES)" ;; esac; done ;;
  esac
  setup_look
  set_root "$root"
  trap on_exit EXIT
  WORK=$(mktemp -d "${TMPDIR:-/tmp}/git-lopper.XXXXXX") || die "cannot create a temporary folder"
  COLS=$({ stty size </dev/tty; } 2>/dev/null | cut -d' ' -f2)
  case $COLS in '' | *[!0-9]*) COLS=80 ;; esac
  HAS_CWD=0
  { command -v lsof >/dev/null 2>&1 || [ -e /proc/self/cwd ]; } && HAS_CWD=1
  HAS_BLOOM=0
  [ -f "$BLOOM_DB" ] && HAS_BLOOM=1
  case $cmd in
    '') tui ;;
    scan) cmd_scan "$fetch" ;;
    list) cmd_list "$tsv" ${args[@]+"${args[@]}"} ;;
    clean) cmd_clean "$dry" "$yes" ${args[@]+"${args[@]}"} ;;
    help) usage ;;
    *) die "unknown command: $cmd (try -h)" ;;
  esac
}

# run only when executed, so the tests can source the functions
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
